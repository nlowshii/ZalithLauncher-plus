<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/background_menu_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="@dimen/top_action_size"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginEnd="@dimen/_2sdp"
            android:background="@drawable/background_top_action"
            android:contentDescription="@string/generic_return"
            android:padding="@dimen/top_action_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="@dimen/top_action_size"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/background_top_action"
            android:contentDescription="@string/generic_home"
            android:padding="@dimen/top_action_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_home"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.movtery.zalithlauncher.ui.view.AnimTextView
            android:id="@+id/app_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_6sdp"
            android:ellipsize="end"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Title"
            android:textColor="@color/menu_bar_text" />

        <ImageButton
            android:id="@+id/files_button"
            android:layout_width="@dimen/top_action_size"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/background_top_action"
            android:contentDescription="@string/main_open_main_dir"
            android:padding="@dimen/top_action_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/account_button"
            android:layout_width="@dimen/top_action_size"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/background_top_action"
            android:contentDescription="@string/account_add"
            android:padding="@dimen/top_action_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_account"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/download_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/background_top_action"
            android:clickable="true"
            android:contentDescription="@string/setting_category_download"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/top_action_size"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/top_action_padding">

            <ImageView
                android:id="@+id/download_icon"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/download_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:text="@string/top_title_download"
                android:textAppearance="@style/TextAppearance.Launcher.Headline"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setting_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_action_size"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/background_top_action"
            android:clickable="true"
            android:contentDescription="@string/setting_category_launcher"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/top_action_size"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/top_action_padding">

            <ImageView
                android:id="@+id/setting_icon"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu_settings"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/setting_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:text="@string/top_title_settings"
                android:textAppearance="@style/TextAppearance.Launcher.Headline"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_layout" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notice_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_12sdp"
        android:background="@drawable/background_card"
        android:padding="@dimen/_12sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/notice_guideline"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_layout"
        app:layout_constraintVertical_bias="0.333">

        <TextView
            android:id="@+id/notice_title_view"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:textColor="@color/black_or_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/_8sdp"
            app:layout_constraintBottom_toTopOf="@+id/notice_got_button"
            app:layout_constraintTop_toBottomOf="@+id/notice_title_view">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notice_message_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/_14sdp" />

                <TextView
                    android:id="@+id/notice_date_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:gravity="end" />

            </LinearLayout>

        </ScrollView>

        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/notice_got_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/generic_ok"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/notice_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35"/>

    <ImageView
        android:id="@+id/hair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_hair" />


</androidx.constraintlayout.widget.ConstraintLayout>