<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:windowAnimationStyle">@style/Animation.Launcher.Window</item>

        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorSurfaceDim">@color/md_surface_dim</item>
        <item name="colorSurfaceBright">@color/md_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Launcher.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Launcher.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Launcher.Large</item>

        <item name="materialButtonStyle">@style/Widget.Launcher.Button.Filled</item>
        <item name="materialCardViewStyle">@style/Widget.Launcher.Card</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>

    <style name="ShapeAppearance.Launcher.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_8sdp</item>
    </style>

    <style name="ShapeAppearance.Launcher.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_12sdp</item>
    </style>

    <style name="ShapeAppearance.Launcher.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_20sdp</item>
    </style>

    <style name="ShapeAppearance.Launcher.Avatar">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>

    <style name="ShapeAppearance.Launcher.Pill">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Animation.Launcher.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/m3_fade_through_in</item>
        <item name="android:activityOpenExitAnimation">@anim/m3_fade_through_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/m3_fade_through_in</item>
        <item name="android:activityCloseExitAnimation">@anim/m3_fade_through_out</item>
    </style>

    <style name="Widget.Launcher.Card" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Medium</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/_12sdp</item>
        <item name="rippleColor">@color/background_ripple_effect</item>
    </style>

    <style name="Widget.Launcher.Card.Tonal" parent="Widget.Launcher.Card">
        <item name="cardBackgroundColor">?attr/colorSecondaryContainer</item>
    </style>

    <style name="Widget.Launcher.Card.Panel" parent="Widget.Launcher.Card">
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Large</item>
        <item name="cardCornerRadius">@dimen/_20sdp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="Widget.Launcher.Button.Filled" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/_40sdp</item>
    </style>

    <style name="Widget.Launcher.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/_36sdp</item>
    </style>

    <style name="Widget.Launcher.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Pill</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Launcher.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:padding">@dimen/_8sdp</item>
    </style>

    <style name="Widget.Launcher.IconButton.Tonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal" />

    <style name="Widget.Launcher.ImageButton">
        <item name="android:background">@drawable/ripple_circle</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/_8sdp</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Launcher.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Launcher.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Launcher.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Launcher.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorSurface">@color/md_surface_container_high</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:windowAnimationStyle">@style/Animation.Launcher.Dialog</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSurface">@color/md_surface_container_high</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="android:windowAnimationStyle">@style/Animation.Launcher.Dialog</item>
    </style>

    <style name="Animation.Launcher.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/m3_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/m3_dialog_out</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
